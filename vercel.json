{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/register",
      "dest": "api/index.js"
    },
    {
      "src": "/login",
      "dest": "api/index.js"
    },
    {
      "src": "/me",
      "dest": "api/index.js"
    },
    {
      "src": "/chat",
      "dest": "api/index.js"
    },
    {
      "src": "/recommend",
      "dest": "api/index.js"
    },
    {
      "src": "/analyze-skill-gap",
      "dest": "api/index.js"
    },
    {
      "src": "/whatsapp",
      "dest": "api/index.js"
    },
    {
      "src": "/interview/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/community/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
